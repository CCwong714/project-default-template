{
  "source": ".clone-ui/source/reference.mov",
  "colors": {
    "lavender": "#c5c3ef",
    "lavenderLight": "#e7e1f8",
    "haloCyan": "#c8f4ff",
    "ink": "#171625",
    "ice": "#fffefd",
    "night": "#010415",
    "electricBlue": "#173eff",
    "ember": "#f04a16",
    "emberDeep": "#250704"
  },
  "typography": {
    "sans": "TT Neoris",
    "display": "The Seasons",
    "heroDesktop": "clamp(9rem, 16vw, 19rem)",
    "heroMobile": "clamp(4.6rem, 20vw, 6rem)",
    "copyTracking": "-0.055em",
    "displayLineHeight": 0.82
  },
  "layout": {
    "desktopGutter": "3vw",
    "mobileGutter": "20px",
    "desktopLogoWidth": "200px",
    "mobileLogoWidth": "150px",
