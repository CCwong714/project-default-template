  "motion": {
    "scrollDampingDesktop": 0.055,
    "scrollDampingMobile": 0.085,
    "copyEnter": "blur(14px) translateY(42px)",
    "copyExit": "blur(14px) translateY(-28px)",
    "easing": "cubic-bezier(0.22, 0.61, 0.36, 1)"
