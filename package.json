{
  "name": "noomo-storytelling-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.14.0"
  },
  "scripts": {
    "prepare:mirror": "node scripts/prepare-exact-mirror.mjs",
    "dev": "npm run prepare:mirror && vite --host",
    "build": "npm run prepare:mirror && tsc -b && vite build",
    "check": "npm run prepare:mirror && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run verify:mirror && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:mirror": "node scripts/verify-exact-mirror.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "three": "^0.179.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.6.0",
    "jsdom": "^27.2.0",
    "playwright": "^1.62.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
